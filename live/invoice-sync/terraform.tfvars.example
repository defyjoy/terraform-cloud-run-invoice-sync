# Reference only — real values live in .auto.tfvars, not this file. Every variable is required
# (no defaults) except image_tag, which the pipeline always passes with -var on the CLI.

project_id   = "yeti-504903"
region       = "us-central1"
service_name = "invoice-sync"

artifact_registry_repo = "invoice-sync"

notification_email = "you@example.com"

vpc_connector_name = "invoice-sync-connector"

# ALL_TRAFFIC, not PRIVATE_RANGES_ONLY: the service calls external APIs, and routing that
# egress through ../network's Cloud NAT (instead of Cloud Run's default direct-to-internet
# path) gives it a logged, auditable egress trail. See ../network's module "router".
vpc_egress = "ALL_TRAFFIC"

lb_name = "invoice-sync-lb"

# No domain yet: ssl stays true (self-signed fallback still encrypts transit) with domains
# empty. Once a real domain is pointed at load_balancer_ip, set lb_domains to it to switch to a
# browser-trusted Google-managed cert.
lb_ssl     = true
lb_domains = []

min_instance_count  = 0
max_instance_count  = 2
deletion_protection = true

deploy_account_id = "github-deployer"

runtime_service_account_project_roles = [
  "roles/logging.logWriter",
  "roles/cloudtrace.agent",
]

db_password_secret_id = "db-password"

expected_db_password = "invoice-sync-test-password"
